+// Reduce a comma-separated list of "WxH" dimensions to a single
+// largest-by-area entry. Used to filter `picture-size-values` and
+// `preview-size-values` so that any client picking the first or default
+// advertised size lands on the sensor-native max instead of a downscaled
+// or letterboxed sub-mode.
+static std::string filterToLargestSize(const std::string& sizes) {
+    long bestArea = 0;
+    std::string best;
+    size_t i = 0;
+    while (i < sizes.size()) {
+        size_t comma = sizes.find(',', i);
+        std::string tok = sizes.substr(i, comma == std::string::npos
+                ? std::string::npos : comma - i);
+        size_t x = tok.find('x');
+        if (x != std::string::npos) {
+            long w = strtol(tok.substr(0, x).c_str(), nullptr, 10);
+            long h = strtol(tok.substr(x + 1).c_str(), nullptr, 10);
+            if (w > 0 && h > 0 && w * h > bestArea) {
+                bestArea = w * h;
+                best = tok;
+            }
+        }
+        if (comma == std::string::npos) break;
+        i = comma + 1;
+    }
+    return best;
+}
