+// Set the EXIF Orientation tag in a JPEG byte stream in-place.
+// Returns true if the tag was found and written. The EXIF SHORT-typed value
+// is updated in the IFD0 entry's inline value field (no offset to follow).
+// Walks JPEG markers from SOI; stops at SOS or first non-FF byte.
+//
+// orientation values (TIFF spec):
+//   1 = top-left (default, no rotation)
+//   3 = bottom-right (180 deg rotation)
+//   6 = right-top  (90 deg CW)
+//   8 = left-bottom (270 deg CW = 90 deg CCW)
+static bool patchJpegExifOrientation(void* jpegData, size_t size, uint16_t newOrientation) {
+    if (jpegData == nullptr || size < 30) return false;
+    uint8_t* p = static_cast<uint8_t*>(jpegData);
+    if (p[0] != 0xFF || p[1] != 0xD8) return false;  // SOI
+
+    size_t i = 2;
+    while (i + 4 < size && p[i] == 0xFF) {
+        if (p[i + 1] == 0xFF) { i++; continue; }
+        if (p[i + 1] == 0xDA) return false;  // SOS reached without EXIF
+        uint16_t segLen = (static_cast<uint16_t>(p[i + 2]) << 8) | p[i + 3];
+        if (segLen < 2 || i + 2 + segLen > size) return false;
+
+        if (p[i + 1] == 0xE1 && i + 10 < size &&
+                p[i + 4] == 'E' && p[i + 5] == 'x' && p[i + 6] == 'i' && p[i + 7] == 'f' &&
+                p[i + 8] == 0 && p[i + 9] == 0) {
+            size_t tiffOff = i + 10;
+            if (tiffOff + 8 > size) return false;
+            bool littleEndian = (p[tiffOff] == 'I' && p[tiffOff + 1] == 'I');
+            bool bigEndian = (p[tiffOff] == 'M' && p[tiffOff + 1] == 'M');
+            if (!littleEndian && !bigEndian) return false;
+
+            auto rd16 = [&](size_t off) -> uint16_t {
+                return littleEndian
+                        ? static_cast<uint16_t>(p[off] | (p[off + 1] << 8))
+                        : static_cast<uint16_t>((p[off] << 8) | p[off + 1]);
+            };
+            auto rd32 = [&](size_t off) -> uint32_t {
+                return littleEndian
+                        ? (uint32_t(p[off]) | (uint32_t(p[off + 1]) << 8)
+                                | (uint32_t(p[off + 2]) << 16) | (uint32_t(p[off + 3]) << 24))
+                        : ((uint32_t(p[off]) << 24) | (uint32_t(p[off + 1]) << 16)
+                                | (uint32_t(p[off + 2]) << 8) | uint32_t(p[off + 3]));
+            };
+
+            uint16_t magic = rd16(tiffOff + 2);
+            if (magic != 42) return false;
+            uint32_t ifd0Off = rd32(tiffOff + 4);
+            size_t ifd0 = tiffOff + ifd0Off;
+            if (ifd0 + 2 > size) return false;
+            uint16_t nEntries = rd16(ifd0);
+            for (uint16_t e = 0; e < nEntries; e++) {
+                size_t entOff = ifd0 + 2 + e * 12;
+                if (entOff + 12 > size) return false;
+                uint16_t tag = rd16(entOff);
+                if (tag == 0x0112) {  // Orientation
+                    uint16_t typ = rd16(entOff + 2);
+                    if (typ != 3) return false;  // expect SHORT
+                    if (littleEndian) {
+                        p[entOff + 8] = static_cast<uint8_t>(newOrientation & 0xFF);
+                        p[entOff + 9] = static_cast<uint8_t>((newOrientation >> 8) & 0xFF);
+                    } else {
+                        p[entOff + 8] = static_cast<uint8_t>((newOrientation >> 8) & 0xFF);
+                        p[entOff + 9] = static_cast<uint8_t>(newOrientation & 0xFF);
+                    }
+                    return true;
+                }
+            }
+            return false;
+        }
+        i += 2 + segLen;
+    }
+    return false;
+}
