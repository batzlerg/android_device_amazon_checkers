+
+    // Allow a device-tree-set sysprop to override the framework-computed
+    // preview transform. Some devices set ro.surface_flinger.primary_display_orientation
+    // to compensate for non-natural panel orientation; this is invisible to
+    // WindowManager and breaks the standard Camera1 orientation->transform
+    // composition. The sysprop allows the device tree to pin the correct
+    // NATIVE_WINDOW_SET_BUFFERS_TRANSFORM value (0-7). No-op when unset.
+    //
+    // The correct sysprop value depends on the consumer of the preview
+    // BufferQueue. SurfaceTexture+GL consumers (e.g. AOSP Camera2 app)
+    // composite the buffer in the app process before SurfaceFlinger sees it;
+    // raw SurfaceView consumers (e.g. Open Camera) hand the buffer directly
+    // to SurfaceFlinger, which composes it with the display-orientation
+    // override. The two paths require different transforms.
+    //
+    // Distinguish the consumer by the framework-computed transform value.
+    // Camera1's CameraClient front-camera mirror flag composes with the
+    // app's setDisplayOrientation request:
+    //   - GL consumer (no setDisplayOrientation): first call carries
+    //     NATIVE_WINDOW_TRANSFORM_FLIP_H (=1).
+    //   - Raw consumer (setDisplayOrientation(90)): first call carries
+    //     NATIVE_WINDOW_TRANSFORM_ROT_90|FLIP_H (=5).
+    // Latch the hint from the first call; subsequent calls inherit it.
+    if (mPreviewConsumerHint == 0) {
+        if (transform == 5) {
+            mPreviewConsumerHint = 1;
+            ALOGI("%s: latched raw-consumer hint (framework=5)", __FUNCTION__);
+        }
+    }
+
+    const char* propName = (mPreviewConsumerHint == 1)
+            ? "persist.camera.preview_transform_raw"
+            : "persist.camera.preview_transform";
+    char prop[PROPERTY_VALUE_MAX] = "";
+    property_get(propName, prop, "");
+    if (prop[0] != '\0') {
+        char* end = nullptr;
+        long override_val = strtol(prop, &end, 10);
+        if (end != prop && *end == '\0' &&
+                override_val >= 0 && override_val <= 7) {
+            ALOGI("%s: framework=%d override=%ld (%s)", __FUNCTION__,
+                    transform, override_val, propName);
+            transform = static_cast<int>(override_val);
+        }
+    }
+
     mPreviewTransform = transform;
     if (mPreviewWindow != nullptr) {
         rc = native_window_set_buffers_transform(mPreviewWindow.get(),
