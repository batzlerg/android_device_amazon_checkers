# cameraserver.te -- checkers (Echo Show 5 Gen 1 / MT8163) additions
#
# On Android 11 HIDL architecture, camera device access has shifted from cameraserver
# to hal_camera_default (the HAL server process). The rules below retain those device
# accesses that cameraserver legitimately needs directly (e.g. pipeline manager used
# by the A11 framework layer) plus the binder_call into hal_camera_default.
#
# Most MTK device rules from karnak's Android 7 cameraserver.te now live in
# hal_camera_default.te (the HIDL HAL server domain). Only framework-layer additions
# that are NOT already in system/sepolicy are listed here.
#
# Reference: karnak (mt8163/android_device_amazon_karnak_old @ e123e756c96f766c02dc82f000a33611f9cfc240)
# cameraserver.te -- Android 7 era; kept minimal here for A11.

# Retain MTK-specific accesses that cameraserver may still perform directly
# (framework enumerates pipeline manager on some MT8163 builds):
allow cameraserver camera_pipemgr_device:chr_file { read open ioctl };
allow cameraserver MTK_SMI_device:chr_file rw_file_perms;
allow cameraserver nvram_data_file:dir { add_name write search };
allow cameraserver nvram_data_file:file { create write setattr getattr open read };
allow cameraserver nvram_device:blk_file { open read write };
allow cameraserver sysfs:file { read write open getattr };
allow cameraserver sysfs_devinfo:file rw_file_perms;
allow cameraserver debugfs_ion:dir search;
allow cameraserver kmsg_device:chr_file { open read write };
allow cameraserver kernel:system { module_request };
