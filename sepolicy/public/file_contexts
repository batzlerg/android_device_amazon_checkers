# file_contexts for checkers (Echo Show 5 Gen 1 / MT8163)
# Adapted from karnak (mt8163/android_device_amazon_karnak_old @ e123e756c96f766c02dc82f000a33611f9cfc240)
# plus the critical camerahalserver exec label (not in karnak — checkers-specific binary name)

# --- MTK camera character devices ---
/dev/kd_camera_hw(/.*)?                                 u:object_r:kd_camera_hw_device:s0
/dev/kd_camera_hw_bus2(/.*)?                            u:object_r:kd_camera_hw_bus2_device:s0
/dev/kd_camera_flashlight(/.*)?                         u:object_r:kd_camera_flashlight_device:s0
/dev/camera-isp(/.*)?                                   u:object_r:camera_isp_device:s0
/dev/camera-pipemgr(/.*)?                               u:object_r:camera_pipemgr_device:s0
/dev/camera-sysram(/.*)?                                u:object_r:camera_sysram_device:s0
/dev/camera-fdvt(/.*)?                                  u:object_r:camera_fdvt_device:s0
/dev/mtk_cmdq(/.*)?                                     u:object_r:mtk_cmdq_device:s0
/dev/MTK_SMI                                            u:object_r:MTK_SMI_device:s0
/dev/CAM_CAL_DRV(/.*)?                                  u:object_r:CAM_CAL_DRV_device:s0

# --- CRITICAL: camerahalserver exec label ---
# Without this, the binary starts in vendor_file domain and all allow rules below are dead.
# The AOSP generic pattern matches android.hardware.camera.provider@2.x-service* but NOT
# a custom binary named "camerahalserver". This checkers-specific entry is required.
/vendor/bin/hw/camerahalserver                          u:object_r:hal_camera_default_exec:s0
